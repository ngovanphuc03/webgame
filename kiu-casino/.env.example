# ============================================================
# PIXEL PLAYZONE - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values

# --- Server ---
PORT=3000
NODE_ENV=development
# NODE_ENV=production  # Enable for production (secure cookies, etc.)

# --- Discord OAuth2 ---
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# --- Discord Bot (optional: enables auto-sync user info for leaderboard) ---
DISCORD_BOT_TOKEN=your_bot_token

# --- Discord Guild ---
GUILD_ID=your_guild_id

# --- Admin Users (comma-separated Discord user IDs, can view all transactions) ---
ADMIN_USER_IDS=your_discord_user_id

# --- MySQL Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=meono
DB_SSL=false

# --- CORS (production only) ---
# ALLOWED_ORIGIN=https://yourdomain.com
